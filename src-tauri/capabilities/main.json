{
  "identifier": "main",
  "windows": [
    "main",
    "search",
    "settings",
    "resource-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-save",
    "dialog:allow-confirm"
  ]
}

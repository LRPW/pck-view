{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PW Forge",
  "version": "0.1.3",
  "identifier": "ru.lrpw.pwforge",
  "build": {
    "beforeDevCommand": "npm run build:native && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PW Forge",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/lrpw/icon.ico",
      "icons/lrpw/icon.png"
    ],
    "targets": [
      "nsis"
    ],
    "resources": {
      "../runtimes/native-gfx/native-gfx.exe": "native-gfx.exe",
      "../runtimes/native-gfx/ImmWrapper.dll": "ImmWrapper.dll",
      "../runtimes/native-gfx/ifc22.dll": "ifc22.dll",
      "../runtimes/native-gfx/zlibwapi.dll": "zlibwapi.dll",
      "../runtimes/native-gfx/msvcp140.dll": "msvcp140.dll",
      "../runtimes/native-gfx/vcruntime140.dll": "vcruntime140.dll",
      "../runtimes/native-gfx/d3dx9_43.dll": "d3dx9_43.dll"
    },
    "fileAssociations": [
      {
        "ext": [
          "pwforge"
        ],
        "name": "PW Forge Project",
        "description": "PW Forge Project"
      },
      {
        "ext": [
          "pck"
        ],
        "name": "PCK Archive",
        "description": "PCK Archive"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/LRPW/pw-forge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LRPW PCK View",
  "version": "0.1.1",
  "identifier": "ru.lordralinc.pckview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LRPW | PCK View",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/lrpw/icon.ico",
      "icons/lrpw/icon.png"
    ]
  }
}
